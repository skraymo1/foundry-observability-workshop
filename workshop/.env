# Required: select Microsoft Foundry as the provider
CLAUDE_CODE_USE_FOUNDRY = "1"

# Required: Foundry resource name OR full base URL
ANTHROPIC_FOUNDRY_RESOURCE = "<FOUNDRY_RESOURCE>"
#ANTHROPIC_FOUNDRY_BASE_URL = "https://<FOUNDRY_RESOURCE>.services.ai.azure.com/anthropic"

# Choose one authentication method
ANTHROPIC_FOUNDRY_API_KEY = "<AZURE_API_KEY>"
# Or use Entra ID: az login
#ANTHROPIC_FOUNDRY_AUTH_TOKEN = "<ENTRA_ACCESS_TOKEN>"
ANTHROPIC_DEFAULT_SONNET_MODEL = "<MODEL_DEPLOYMENT_NAME>"

